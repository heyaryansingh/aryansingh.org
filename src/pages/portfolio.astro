---
/**
 * Portfolio — rendered from the `projects` content collection.
 * Bold, filterable grid. Each card links to its full case study at /portfolio/[slug].
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getSortedProjects, usedCategories, CATEGORY_META } from "../lib/projects";

const projects = await getSortedProjects();
const cats = usedCategories(projects);
const counts: Record<string, number> = { all: projects.length };
for (const p of projects) counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;
---

<BaseLayout title="Portfolio" description="Projects by Aryan Singh — AI, quantum, biotech, quant, and developer tools.">
  <div class="pf">
    <header class="pf__head">
      <p class="pf__eyebrow">selected work</p>
      <h1 class="pf__title">Things I've built</h1>
      <p class="pf__sub">
        {projects.length} projects across AI, quantum computing, biotech, quantitative trading, and
        developer tooling — from research prototypes to shipped products.
      </p>
      <div class="pf__stats">
        <span><strong>{projects.length}</strong> projects</span>
        <span class="dot">·</span>
        <span><strong>{cats.length}</strong> domains</span>
        <span class="dot">·</span>
        <span><strong>{projects.filter((p) => p.data.status === "active").length}</strong> active</span>
      </div>
    </header>

    <div class="pf__filter" id="pf-filter">
      <button class="pf__chip is-active" data-category="all">All <span class="pf__count">{counts.all}</span></button>
      {cats.map((c) => (
        <button class="pf__chip" data-category={c}>
          <span class="pf__chip-icon">{CATEGORY_META[c].icon}</span>{CATEGORY_META[c].label}
          <span class="pf__count">{counts[c]}</span>
        </button>
      ))}
    </div>

    <div class="pf__grid" id="projects-grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>

    <p class="pf__empty" id="portfolio-empty" hidden>Nothing here yet in this category.</p>
  </div>
</BaseLayout>

<style>
  .pf { max-width: 1100px; margin: 0 auto; padding: var(--space-2xl) var(--space-lg) var(--space-4xl); }
  .pf__head { text-align: center; max-width: 640px; margin: 0 auto var(--space-2xl); }
  .pf__eyebrow { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase;
    letter-spacing: 0.2em; color: var(--color-accent-secondary); margin: 0 0 var(--space-sm); }
  .pf__title { font-size: var(--text-5xl); margin: 0; }
  .pf__sub { font-size: var(--text-base); color: var(--color-text-secondary); margin: var(--space-md) auto 0; max-width: 540px; }
  .pf__stats { display: flex; justify-content: center; gap: var(--space-md); margin-top: var(--space-lg);
    font-size: var(--text-sm); color: var(--color-text-tertiary); }
  .pf__stats strong { color: var(--color-accent-highlight); font-weight: 600; font-variant-numeric: tabular-nums; }
  .dot { opacity: 0.4; }

  .pf__filter { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-sm); margin-bottom: var(--space-2xl); }
  .pf__chip { display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; font-size: var(--text-sm);
    color: var(--color-text-secondary); background: var(--color-bg-secondary); border: 1px solid var(--color-border);
    border-radius: var(--radius-full); cursor: pointer; transition: all var(--transition-fast); font-family: var(--font-sans); }
  .pf__chip:hover { color: var(--color-text-primary); border-color: var(--color-accent-primary); transform: translateY(-1px); }
  .pf__chip.is-active { color: #fff; background: var(--color-accent-primary); border-color: var(--color-accent-primary); }
  .pf__chip-icon { font-size: 0.95rem; }
  .pf__count { font-family: var(--font-mono); font-size: var(--text-xs); opacity: 0.7; }

  .pf__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-lg); align-items: stretch; }
  .pf__empty { text-align: center; color: var(--color-text-tertiary); margin-top: var(--space-2xl); }

  @media (prefers-reduced-motion: no-preference) {
    .pf__grid :global(.pcard) { animation: pf-in 0.6s var(--ease-out-expo) both; animation-delay: var(--delay); }
    @keyframes pf-in { from { opacity: 0; transform: translateY(18px); } }
  }

  @media (max-width: 640px) {
    .pf__grid { grid-template-columns: 1fr; }
    .pf__title { font-size: var(--text-4xl); }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const filter = document.getElementById("pf-filter");
    const grid = document.getElementById("projects-grid");
    const empty = document.getElementById("portfolio-empty");
    if (!filter || !grid) return;
    const chips = filter.querySelectorAll<HTMLButtonElement>(".pf__chip");
    const cards = grid.querySelectorAll<HTMLElement>("[data-category]");

    const apply = (category: string) => {
      let visible = 0;
      cards.forEach((card) => {
        const show = category === "all" || card.dataset.category === category;
        card.style.display = show ? "" : "none";
        if (show) visible++;
      });
      if (empty) empty.hidden = visible !== 0;
      chips.forEach((c) => c.classList.toggle("is-active", c.dataset.category === category));
    };

    chips.forEach((chip) =>
      chip.addEventListener("click", () => apply(chip.dataset.category || "all")),
    );
  });
</script>
