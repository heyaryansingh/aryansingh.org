---
/**
 * Projects — a plain typographic list grouped by domain, from the `projects`
 * content collection. Each row links to its full case study at /portfolio/[slug].
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSortedProjects, usedCategories, CATEGORY_META } from "../lib/projects";

const projects = await getSortedProjects();
const cats = usedCategories(projects);
const byCat = cats.map((c) => ({
  cat: c,
  label: CATEGORY_META[c].label,
  items: projects.filter((p) => p.data.category === c),
}));
---

<BaseLayout title="Projects" description="Projects by Aryan Singh: AI, quantum, biotech, quant, and developer tools.">
  <div class="pf">
    <header class="pf__head">
      <h1 class="pf__title">Projects</h1>
      <p class="pf__sub">
        {projects.length} things I've built: research prototypes, shipped products, and a few
        experiments. Click any for the full write-up.
      </p>
    </header>

    {byCat.map((group) => (
      <section class="pf__group">
        <h2 class="pf__cat">{group.label}</h2>
        <ul class="pf__list">
          {group.items.map((p) => (
            <li>
              <a class="pf__row" href={`/portfolio/${p.slug}`}>
                <span class="pf__rmain">
                  <span class="pf__rtitle">
                    {p.data.title}
                    {p.data.closedSource && !p.data.github && <span class="pf__priv">private</span>}
                  </span>
                  <span class="pf__rtag">{p.data.tagline}</span>
                </span>
                {p.data.year && <span class="pf__ryear">{p.data.year}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .pf { max-width: 44rem; margin: 0 auto; padding: clamp(var(--space-2xl), 8vw, var(--space-4xl)) var(--space-lg) var(--space-4xl); }
  .pf__head { margin-bottom: var(--space-2xl); }
  .pf__title { font-family: var(--font-serif); font-size: var(--text-4xl); font-weight: 500; margin: 0; letter-spacing: -0.02em; }
  .pf__sub { font-size: var(--text-base); color: var(--color-text-secondary); line-height: 1.7; margin: var(--space-md) 0 0; max-width: 40rem; }

  .pf__group { margin-top: var(--space-2xl); }
  .pf__cat { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500; text-transform: uppercase;
    letter-spacing: 0.16em; color: var(--color-text-tertiary); margin: 0 0 var(--space-sm); }
  .pf__list { list-style: none; margin: 0; padding: 0; }

  .pf__row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-lg);
    padding: var(--space-md) 0; border-top: 1px solid var(--color-border-subtle); }
  .pf__list li:last-child .pf__row { border-bottom: 1px solid var(--color-border-subtle); }
  .pf__rmain { min-width: 0; }
  .pf__rtitle { font-family: var(--font-serif); font-size: var(--text-lg); color: var(--color-text-primary);
    display: inline-flex; align-items: baseline; gap: var(--space-sm); }
  .pf__row:hover .pf__rtitle { color: var(--color-accent); }
  .pf__priv { font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--color-text-tertiary); border: 1px solid var(--color-border); padding: 1px 5px; }
  .pf__rtag { display: block; font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.5; margin-top: 2px; }
  .pf__ryear { flex: 0 0 auto; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-tertiary); font-variant-numeric: tabular-nums; }
</style>
