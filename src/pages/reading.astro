---
/**
 * Reading — "The Stacks"
 *
 * A personal library. Data + long-form notes live in the `reads` MDX
 * collection (src/content/reads/*.mdx). Each book links to its own
 * /reading/[slug] page where notes are written and published.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Recommendations from "../components/interactive/Recommendations";

type Read = CollectionEntry<"reads">;

const all = await getCollection("reads");

const byRecency = (a: Read, b: Read) => {
    const ad = (a.data.finishedDate ?? a.data.startedDate)?.valueOf() ?? 0;
    const bd = (b.data.finishedDate ?? b.data.startedDate)?.valueOf() ?? 0;
    if (bd !== ad) return bd - ad;
    return b.data.order - a.data.order;
};

const reading = all
    .filter((b) => b.data.status === "reading")
    .sort(byRecency);
const completed = all
    .filter((b) => b.data.status === "completed")
    .sort(byRecency);

const thisYear = new Date().getUTCFullYear();
const finishedThisYear = completed.filter(
    (b) => b.data.finishedDate?.getUTCFullYear() === thisYear,
).length;

const stats = [
    { value: all.length, label: "tracked" },
    { value: completed.length, label: "finished" },
    { value: reading.length, label: "in progress" },
];

const sections = [
    { id: "current", title: "Currently Reading", items: reading },
    { id: "finished", title: "Finished", items: completed },
].filter((s) => s.items.length > 0);

function fmt(date?: Date) {
    if (!date) return "";
    return new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
    }).format(date);
}

function dateLabel(b: Read) {
    if (b.data.finishedDate) {
        const start = fmt(b.data.startedDate);
        const end = fmt(b.data.finishedDate);
        return start && start !== end ? `${start} – ${end}` : end;
    }
    return b.data.startedDate ? `Started ${fmt(b.data.startedDate)}` : "";
}

---

<BaseLayout
    title="Reading"
    description="A personal library: books I'm reading, books I've finished, and my notes on them."
>
    <div class="stacks">
        <header class="stacks__head">
            <p class="stacks__eyebrow animate-fade-in">The Stacks</p>
            <h1 class="stacks__title animate-slide-up">Reading</h1>
            <p class="stacks__subtitle animate-fade-in">
                A working library: what I'm reading now, what I've finished, and
                the thoughts each book left behind.
            </p>

            <dl class="stacks__stats animate-fade-in">
                {
                    stats.map((s) => (
                        <div class="stat">
                            <dt class="stat__value">{s.value}</dt>
                            <dd class="stat__label">{s.label}</dd>
                        </div>
                    ))
                }
                <div class="stat">
                    <dt class="stat__value">{finishedThisYear}</dt>
                    <dd class="stat__label">in {thisYear}</dd>
                </div>
            </dl>
        </header>

        {
            sections.map((section) => (
                <section class="shelf" id={section.id}>
                    <div class="shelf__head">
                        <h2 class="shelf__title">{section.title}</h2>
                        <span class="shelf__rule" />
                        <span class="shelf__count">
                            {section.items.length}
                        </span>
                    </div>

                    <div class="shelf__list">
                        {section.items.map((book) => (
                            <details
                                class="book"
                                style={`--spine: ${book.data.spine}`}
                            >
                                <summary class="book__row">
                                    <span class="book__chip" aria-hidden="true"
                                    ></span>
                                    <span class="book__head">
                                        <span class="book__title"
                                            >{book.data.title}</span
                                        >
                                        <span class="book__author"
                                            >{book.data.author}</span
                                        >
                                    </span>
                                    {
                                        book.data.rating != null && (
                                            <span
                                                class="book__rating"
                                                title={`${book.data.rating} / 5`}
                                            >
                                                {"★".repeat(
                                                    Math.round(
                                                        book.data.rating,
                                                    ),
                                                )}
                                            </span>
                                        )
                                    }
                                    <span class="book__marker" aria-hidden="true"
                                        >+</span
                                    >
                                </summary>
                                <div class="book__more">
                                    <p class="book__overview">
                                        {book.data.overview}
                                    </p>
                                    <p class="book__meta">
                                        {book.data.tags.join(" · ")}
                                        {dateLabel(book) && (
                                            <span> · {dateLabel(book)}</span>
                                        )}
                                    </p>
                                    <p class="book__links">
                                        <a href={`/reading/${book.slug}`}
                                            >my notes →</a
                                        >
                                        <a
                                            href={book.data.link}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            >find online ↗</a
                                        >
                                    </p>
                                </div>
                            </details>
                        ))}
                    </div>
                </section>
            ))
        }

        <section class="shelf" id="recommend">
            <div class="shelf__head">
                <h2 class="shelf__title">Recommend me something</h2>
                <span class="shelf__rule" />
            </div>
            <p class="shelf__lede">
                A book, paper, film, blog, or podcast. Anything worth my time,
                drop it here and I'll work through the list.
            </p>
            <Recommendations client:load />
        </section>
    </div>
</BaseLayout>

<style>
    .stacks {
        max-width: 46rem;
        margin: 0 auto;
        padding: var(--space-2xl) var(--space-xl) var(--space-4xl);
    }

    /* ---------- Header ---------- */
    .stacks__head {
        margin-bottom: var(--space-2xl);
    }

    .stacks__eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--color-accent-primary);
        margin: 0 0 var(--space-sm);
    }

    .stacks__title {
        font-family: var(--font-serif);
        font-size: var(--text-5xl);
        font-weight: 400;
        line-height: 1;
        margin: 0;
    }

    .stacks__subtitle {
        max-width: 52ch;
        margin: var(--space-md) 0 var(--space-xl);
        color: var(--color-text-secondary);
        font-size: var(--text-base);
        line-height: 1.7;
    }

    .stacks__stats {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xl);
        margin: 0;
        padding-top: var(--space-lg);
        border-top: 1px solid var(--color-border-subtle);
    }

    .stat {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .stat__value {
        font-family: var(--font-serif);
        font-size: var(--text-2xl);
        color: var(--color-text-primary);
        line-height: 1;
    }

    .stat__label {
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-tertiary);
    }

    /* ---------- Shelf ---------- */
    .shelf {
        margin-top: var(--space-2xl);
        scroll-margin-top: 90px;
    }

    .shelf__head {
        display: flex;
        align-items: center;
        gap: var(--space-md);
        margin-bottom: var(--space-lg);
    }

    .shelf__title {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
        margin: 0;
        white-space: nowrap;
    }

    .shelf__rule {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            90deg,
            var(--color-border),
            transparent
        );
    }

    .shelf__count {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-tertiary);
    }

    .shelf__lede {
        max-width: 60ch;
        margin: 0 0 var(--space-lg);
        color: var(--color-text-tertiary);
        font-size: var(--text-sm);
        line-height: 1.7;
    }

    .shelf__list {
        display: flex;
        flex-direction: column;
    }

    /* ---------- Book rows (compact, expandable) ---------- */
    .book {
        border-top: 1px solid var(--color-border-subtle);
    }
    .shelf__list .book:last-child {
        border-bottom: 1px solid var(--color-border-subtle);
    }

    .book__row {
        display: flex;
        align-items: baseline;
        gap: var(--space-md);
        padding: var(--space-md) var(--space-xs);
        cursor: pointer;
        list-style: none;
    }
    .book__row::-webkit-details-marker {
        display: none;
    }
    .book__row:hover .book__title {
        color: var(--color-accent);
    }

    .book__chip {
        flex: 0 0 auto;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: var(--spine);
        align-self: center;
    }

    .book__head {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: baseline;
        gap: var(--space-sm);
        flex-wrap: wrap;
    }

    .book__title {
        font-family: var(--font-serif);
        font-size: var(--text-lg);
        color: var(--color-text-primary);
        line-height: 1.3;
    }

    .book__author {
        font-size: var(--text-sm);
        color: var(--color-text-tertiary);
    }

    .book__rating {
        flex: 0 0 auto;
        font-size: var(--text-xs);
        color: var(--color-text-secondary);
        letter-spacing: 0.1em;
    }

    .book__marker {
        flex: 0 0 auto;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--color-text-tertiary);
        transition: transform var(--transition-fast);
    }
    .book[open] .book__marker {
        transform: rotate(45deg);
    }

    .book__more {
        padding: 0 var(--space-xs) var(--space-lg) calc(8px + var(--space-md) + var(--space-xs));
    }

    .book__overview {
        margin: 0 0 var(--space-sm);
        font-size: var(--text-sm);
        line-height: 1.7;
        color: var(--color-text-secondary);
        max-width: 60ch;
    }

    .book__meta {
        margin: 0 0 var(--space-sm);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-tertiary);
    }

    .book__links {
        margin: 0;
        display: flex;
        gap: var(--space-lg);
    }
    .book__links a {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-secondary);
    }
    .book__links a:hover {
        color: var(--color-accent);
    }

    /* ---------- Entrance animation ---------- */
    .animate-rise {
        opacity: 0;
        animation: rise 0.5s var(--ease-out-expo) forwards;
        animation-delay: var(--delay);
    }

    @keyframes rise {
        from {
            opacity: 0;
            transform: translateY(14px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-slide-up {
        animation: rise 0.5s var(--ease-out-expo) forwards;
        opacity: 0;
    }

    .animate-fade-in {
        animation: fadeIn 0.6s ease forwards;
        animation-delay: 0.1s;
        opacity: 0;
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
        }
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 640px) {
        .stacks {
            padding: var(--space-xl) var(--space-lg) var(--space-3xl);
        }

    }

    @media (prefers-reduced-motion: reduce) {
        .animate-rise,
        .animate-slide-up,
        .animate-fade-in {
            animation: none;
            opacity: 1;
        }

    }
</style>
