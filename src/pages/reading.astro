---
/**
 * Reading — "The Stacks"
 *
 * A personal library. Data + long-form notes live in the `reads` MDX
 * collection (src/content/reads/*.mdx). Each book links to its own
 * /reading/[slug] page where notes are written and published.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type Read = CollectionEntry<"reads">;

const all = await getCollection("reads");

const byRecency = (a: Read, b: Read) => {
    const ad = (a.data.finishedDate ?? a.data.startedDate)?.valueOf() ?? 0;
    const bd = (b.data.finishedDate ?? b.data.startedDate)?.valueOf() ?? 0;
    if (bd !== ad) return bd - ad;
    return b.data.order - a.data.order;
};

const reading = all
    .filter((b) => b.data.status === "reading")
    .sort(byRecency);
const completed = all
    .filter((b) => b.data.status === "completed")
    .sort(byRecency);

const thisYear = new Date().getUTCFullYear();
const finishedThisYear = completed.filter(
    (b) => b.data.finishedDate?.getUTCFullYear() === thisYear,
).length;

const stats = [
    { value: all.length, label: "tracked" },
    { value: completed.length, label: "finished" },
    { value: reading.length, label: "in progress" },
];

const sections = [
    { id: "current", title: "Currently Reading", items: reading },
    { id: "finished", title: "Finished", items: completed },
].filter((s) => s.items.length > 0);

function fmt(date?: Date) {
    if (!date) return "";
    return new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
    }).format(date);
}

function dateLabel(b: Read) {
    if (b.data.finishedDate) {
        const start = fmt(b.data.startedDate);
        const end = fmt(b.data.finishedDate);
        return start && start !== end ? `${start} – ${end}` : end;
    }
    return b.data.startedDate ? `Started ${fmt(b.data.startedDate)}` : "";
}

// Build a two-letter monogram for the image-free "spine"
function monogram(title: string) {
    const words = title.replace(/^(the|a|an)\s+/i, "").split(/\s+/);
    return (words[0]?.[0] ?? "") + (words[1]?.[0] ?? "");
}
---

<BaseLayout
    title="Reading"
    description="A personal library — books I'm reading, books I've finished, and my notes on them."
>
    <div class="stacks">
        <header class="stacks__head">
            <p class="stacks__eyebrow animate-fade-in">The Stacks</p>
            <h1 class="stacks__title animate-slide-up">Reading</h1>
            <p class="stacks__subtitle animate-fade-in">
                A working library — what I'm reading now, what I've finished, and
                the thoughts each book left behind.
            </p>

            <dl class="stacks__stats animate-fade-in">
                {
                    stats.map((s) => (
                        <div class="stat">
                            <dt class="stat__value">{s.value}</dt>
                            <dd class="stat__label">{s.label}</dd>
                        </div>
                    ))
                }
                <div class="stat">
                    <dt class="stat__value">{finishedThisYear}</dt>
                    <dd class="stat__label">in {thisYear}</dd>
                </div>
            </dl>
        </header>

        {
            sections.map((section) => (
                <section class="shelf" id={section.id}>
                    <div class="shelf__head">
                        <h2 class="shelf__title">{section.title}</h2>
                        <span class="shelf__rule" />
                        <span class="shelf__count">
                            {section.items.length}
                        </span>
                    </div>

                    <div
                        class:list={[
                            "shelf__grid",
                            section.id === "current" && "shelf__grid--feature",
                        ]}
                    >
                        {section.items.map((book, i) => (
                            <article
                                class:list={[
                                    "book animate-rise",
                                    book.data.status === "reading" &&
                                        "book--reading",
                                ]}
                                style={`--spine: ${book.data.spine}; --delay: ${i * 0.06}s`}
                            >
                                <a
                                    href={`/reading/${book.slug}`}
                                    class="book__cover"
                                    aria-hidden="true"
                                    tabindex="-1"
                                >
                                    <span class="book__mono">
                                        {monogram(book.data.title)}
                                    </span>
                                    {book.data.status === "reading" && (
                                        <span class="book__pulse" />
                                    )}
                                </a>

                                <div class="book__body">
                                    <div class="book__topline">
                                        <span class="book__type">
                                            {book.data.type}
                                        </span>
                                        {book.data.rating != null && (
                                            <span
                                                class="book__rating"
                                                title={`${book.data.rating} / 5`}
                                            >
                                                {"★"
                                                    .repeat(
                                                        Math.round(
                                                            book.data.rating,
                                                        ),
                                                    )
                                                    .padEnd(5, "☆")}
                                            </span>
                                        )}
                                    </div>

                                    <h3 class="book__title">
                                        <a href={`/reading/${book.slug}`}>
                                            {book.data.title}
                                        </a>
                                    </h3>
                                    <p class="book__author">
                                        {book.data.author}
                                    </p>

                                    <p class="book__overview">
                                        {book.data.overview}
                                    </p>

                                    {book.data.tags.length > 0 && (
                                        <ul class="book__tags">
                                            {book.data.tags.map((t) => (
                                                <li class="book__tag">{t}</li>
                                            ))}
                                        </ul>
                                    )}

                                    <div class="book__foot">
                                        <span class="book__date">
                                            {dateLabel(book)}
                                        </span>
                                        <span class="book__links">
                                            <a
                                                href={`/reading/${book.slug}`}
                                                class="book__notes"
                                            >
                                                Read notes →
                                            </a>
                                            <a
                                                href={book.data.link}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="book__find"
                                            >
                                                Find online ↗
                                            </a>
                                        </span>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </div>
                </section>
            ))
        }
    </div>
</BaseLayout>

<style>
    .stacks {
        max-width: 980px;
        margin: 0 auto;
        padding: var(--space-2xl) var(--space-xl) var(--space-4xl);
    }

    /* ---------- Header ---------- */
    .stacks__head {
        margin-bottom: var(--space-2xl);
    }

    .stacks__eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--color-accent-primary);
        margin: 0 0 var(--space-sm);
    }

    .stacks__title {
        font-family: var(--font-serif);
        font-size: var(--text-5xl);
        font-weight: 400;
        line-height: 1;
        margin: 0;
    }

    .stacks__subtitle {
        max-width: 52ch;
        margin: var(--space-md) 0 var(--space-xl);
        color: var(--color-text-secondary);
        font-size: var(--text-base);
        line-height: 1.7;
    }

    .stacks__stats {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xl);
        margin: 0;
        padding-top: var(--space-lg);
        border-top: 1px solid var(--color-border-subtle);
    }

    .stat {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .stat__value {
        font-family: var(--font-serif);
        font-size: var(--text-2xl);
        color: var(--color-text-primary);
        line-height: 1;
    }

    .stat__label {
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-tertiary);
    }

    /* ---------- Shelf ---------- */
    .shelf {
        margin-top: var(--space-2xl);
        scroll-margin-top: 90px;
    }

    .shelf__head {
        display: flex;
        align-items: center;
        gap: var(--space-md);
        margin-bottom: var(--space-lg);
    }

    .shelf__title {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
        margin: 0;
        white-space: nowrap;
    }

    .shelf__rule {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            90deg,
            var(--color-border),
            transparent
        );
    }

    .shelf__count {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-tertiary);
    }

    .shelf__grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: var(--space-lg);
    }

    .shelf__grid--feature {
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    }

    /* ---------- Book card ---------- */
    .book {
        position: relative;
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: var(--space-lg);
        padding: var(--space-lg);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: color-mix(in srgb, var(--color-bg-secondary) 70%, transparent);
        overflow: hidden;
        transition:
            transform var(--transition-base) var(--ease-out-expo),
            border-color var(--transition-base),
            box-shadow var(--transition-base);
    }

    /* faint spine-coloured wash bleeding in from the left edge */
    .book::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            90deg,
            color-mix(in srgb, var(--spine) 22%, transparent),
            transparent 38%
        );
        opacity: 0.5;
        pointer-events: none;
        transition: opacity var(--transition-base);
    }

    .book:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--spine) 60%, var(--color-border));
        box-shadow:
            0 18px 40px rgba(0, 0, 0, 0.35),
            0 0 0 1px color-mix(in srgb, var(--spine) 25%, transparent);
    }

    .book:hover::before {
        opacity: 0.85;
    }

    /* ---------- Cover / spine ---------- */
    .book__cover {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        aspect-ratio: 2 / 3;
        border-radius: 3px 5px 5px 3px;
        background:
            linear-gradient(
                115deg,
                color-mix(in srgb, var(--spine) 92%, white 8%),
                color-mix(in srgb, var(--spine) 70%, black 30%)
            );
        box-shadow:
            inset 6px 0 8px -6px rgba(0, 0, 0, 0.6),
            inset -1px 0 0 rgba(255, 255, 255, 0.12),
            0 4px 12px rgba(0, 0, 0, 0.35);
        background-image: none;
        padding: 6px;
        text-decoration: none;
    }

    /* book "binding" line near the spine */
    .book__cover::after {
        content: "";
        position: absolute;
        top: 6%;
        bottom: 6%;
        left: 7px;
        width: 1px;
        background: rgba(255, 255, 255, 0.18);
    }

    .book__mono {
        font-family: var(--font-serif);
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.92);
        text-transform: uppercase;
        line-height: 1;
        padding-bottom: 2px;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
        background: none;
    }

    .book__pulse {
        position: absolute;
        top: 7px;
        right: 7px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
        animation: pulse 2.4s ease-out infinite;
    }

    @keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.5);
        }
        70% {
            box-shadow: 0 0 0 8px rgba(255, 255, 255, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
        }
    }

    /* ---------- Body ---------- */
    .book__body {
        position: relative;
        z-index: 1;
        min-width: 0;
    }

    .book__topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm);
        margin-bottom: var(--space-xs);
    }

    .book__type {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--spine) 70%, var(--color-text-tertiary));
    }

    .book__rating {
        font-size: var(--text-sm);
        letter-spacing: 0.05em;
        color: var(--color-accent-highlight);
    }

    .book__title {
        font-family: var(--font-serif);
        font-size: var(--text-xl);
        line-height: 1.2;
        margin: 0;
    }

    .book__title a {
        color: var(--color-text-primary);
        background: none;
    }

    .book__title a:hover {
        color: var(--color-accent-highlight);
        background: none;
    }

    .book__author {
        margin: 2px 0 var(--space-sm);
        font-size: var(--text-sm);
        color: var(--color-text-tertiary);
        font-style: italic;
    }

    .book__overview {
        margin: 0 0 var(--space-md);
        font-size: var(--text-sm);
        line-height: 1.6;
        color: var(--color-text-secondary);
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .book__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        list-style: none;
        padding: 0;
        margin: 0 0 var(--space-md);
    }

    .book__tag {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.04em;
        padding: 2px 8px;
        border-radius: var(--radius-full);
        color: var(--color-text-tertiary);
        border: 1px solid var(--color-border);
        text-transform: lowercase;
    }

    .book__foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm);
        padding-top: var(--space-sm);
        border-top: 1px solid var(--color-border-subtle);
    }

    .book__date {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-tertiary);
    }

    .book__links {
        display: inline-flex;
        gap: var(--space-md);
    }

    .book__notes,
    .book__find {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        background: none;
    }

    .book__notes {
        color: var(--color-accent-primary);
    }

    .book__notes:hover {
        color: var(--color-accent-highlight);
        background: none;
    }

    .book__find {
        color: var(--color-text-tertiary);
    }

    .book__find:hover {
        color: var(--color-text-secondary);
        background: none;
    }

    /* ---------- Entrance animation ---------- */
    .animate-rise {
        opacity: 0;
        animation: rise 0.5s var(--ease-out-expo) forwards;
        animation-delay: var(--delay);
    }

    @keyframes rise {
        from {
            opacity: 0;
            transform: translateY(14px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-slide-up {
        animation: rise 0.5s var(--ease-out-expo) forwards;
        opacity: 0;
    }

    .animate-fade-in {
        animation: fadeIn 0.6s ease forwards;
        animation-delay: 0.1s;
        opacity: 0;
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
        }
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 640px) {
        .stacks {
            padding: var(--space-xl) var(--space-lg) var(--space-3xl);
        }

        .shelf__grid,
        .shelf__grid--feature {
            grid-template-columns: 1fr;
        }

        .book {
            grid-template-columns: 52px 1fr;
            gap: var(--space-md);
        }

        .book__foot {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-rise,
        .animate-slide-up,
        .animate-fade-in {
            animation: none;
            opacity: 1;
        }

        .book__pulse {
            animation: none;
        }
    }
</style>
