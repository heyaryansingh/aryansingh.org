---
/**
 * Reading Page
 *
 * Books, papers, movies - no icons, clean list
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import readingData from "../data/reading-list.json";

type ReadingItem = {
    title: string;
    author: string;
    type: string;
    status: "reading" | "completed";
    startedDate: string;
    finishedDate?: string;
    link: string;
    overview: string;
};

const sections = [
    {
        title: "Currently Reading",
        items: readingData.currentlyReading as ReadingItem[],
    },
    {
        title: "Completed",
        items: readingData.completed as ReadingItem[],
    },
].filter((section) => section.items.length > 0);

function formatReadingDate(date: string) {
    const [year, month, day] = date.split("-").map(Number);
    return new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
    }).format(new Date(Date.UTC(year, month - 1, day)));
}

function getDateLabel(item: ReadingItem) {
    if (item.finishedDate) {
        return `${formatReadingDate(item.startedDate)} - ${formatReadingDate(item.finishedDate)}`;
    }

    return `Started ${formatReadingDate(item.startedDate)}`;
}
---

<BaseLayout title="Reading" description="Books, papers, and movies">
    <div class="reading">
        <h1 class="reading__title animate-slide-up">Reading</h1>
        <p class="reading__subtitle animate-fade-in">
            Books, papers, and movies I've been consuming
        </p>

        <div class="reading__sections">
            {
                sections.map((section) => (
                    <section class="reading-section">
                        <h2 class="reading-section__title">{section.title}</h2>

                        <div class="reading__list">
                            {section.items.map((item, i) => (
                                <article
                                    class="item animate-slide-up"
                                    style={`--delay: ${0.1 + i * 0.05}s`}
                                >
                                    <div class="item__main">
                                        <div>
                                            <a
                                                href={item.link}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="item__title"
                                            >
                                                {item.title}
                                            </a>
                                            <p class="item__author">
                                                {item.author}
                                            </p>
                                        </div>

                                        <a
                                            href={item.link}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="item__link"
                                        >
                                            Find online
                                        </a>
                                    </div>

                                    <div class="item__meta">
                                        <span class="item__type">
                                            {item.type}
                                        </span>
                                        <span class="item__status">
                                            {item.status}
                                        </span>
                                        <span class="item__date">
                                            {getDateLabel(item)}
                                        </span>
                                    </div>

                                    <p class="item__overview">
                                        {item.overview}
                                    </p>
                                </article>
                            ))}
                        </div>
                    </section>
                ))
            }
        </div>
    </div>
</BaseLayout>

<style>
    .reading {
        max-width: 650px;
        margin: 0 auto;
        padding: var(--space-2xl) var(--space-xl);
    }

    .reading__title {
        font-family: var(--font-serif);
        font-size: var(--text-4xl);
        font-weight: 400;
        margin: 0 0 var(--space-xs);
    }

    .reading__subtitle {
        font-size: var(--text-sm);
        color: var(--color-text-tertiary);
        margin: 0 0 var(--space-2xl);
    }

    .reading__sections {
        display: flex;
        flex-direction: column;
        gap: var(--space-xl);
    }

    .reading-section__title {
        margin: 0 0 var(--space-sm);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 500;
        color: var(--color-text-tertiary);
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .reading__list {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .item {
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: var(--space-lg);
        transition: all 0.3s ease;
        animation: slideUp 0.4s ease forwards;
        animation-delay: var(--delay);
        opacity: 0;
        background: rgba(255, 255, 255, 0.02);
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .item:hover {
        border-color: var(--color-accent-primary);
    }

    .item__main {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-md);
        margin-bottom: var(--space-sm);
    }

    .item__title {
        display: inline-block;
        font-weight: 500;
        color: var(--color-text-primary);
        text-decoration: none;
    }

    .item__title:hover {
        color: var(--color-accent-highlight);
    }

    .item__author {
        margin: var(--space-xs) 0 0;
        font-size: var(--text-sm);
        color: var(--color-text-tertiary);
    }

    .item__link {
        flex: 0 0 auto;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-accent-primary);
        text-decoration: none;
    }

    .item__link:hover {
        color: var(--color-accent-highlight);
    }

    .item__meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-sm) var(--space-md);
        margin-bottom: var(--space-md);
    }

    .item__type,
    .item__status {
        font-size: var(--text-xs);
        color: var(--color-accent-primary);
        text-transform: lowercase;
    }

    .item__status {
        color: var(--color-text-tertiary);
    }

    .item__date {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-tertiary);
    }

    .item__overview {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin: 0;
    }

    @media (max-width: 640px) {
        .reading {
            padding: var(--space-xl) var(--space-lg);
        }

        .item__main {
            flex-direction: column;
            gap: var(--space-sm);
        }
    }

    .animate-slide-up {
        animation: slideUp 0.4s ease forwards;
        opacity: 0;
    }

    .animate-fade-in {
        animation: fadeIn 0.4s ease forwards;
        animation-delay: 0.1s;
        opacity: 0;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
</style>
