---
/**
 * /persona — dedicated landing page for the Persona project.
 * Full demo video up front, then concise information / capabilities / how-to-run.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Persona — a synthetic researcher with a persistent self";
const description =
  "A persistent, always-on synthetic researcher for the scientific literature. It reads at scale, believes with discipline, verifies its own reasoning, and compounds knowledge you can audit.";
---

<BaseLayout title={title} description={description} image="/persona-poster.jpg">
  <article class="pna">

    <header class="pna-hero">
      <p class="pna-kicker">A synthetic researcher with a persistent self</p>
      <h1>Read the whole field. <span class="o">Forget nothing.</span></h1>
      <p class="pna-lede">
        Persona is a persistent, always-on synthetic researcher for the scientific
        literature. It reads at scale, believes with discipline, verifies its own
        reasoning, and compounds knowledge you can audit.
      </p>
      <div class="pna-cta">
        <a class="pna-btn primary" href="#demo">Watch the demo</a>
        <a class="pna-btn" href="https://www.youtube.com/watch?v=wafyHTrnPFI" target="_blank" rel="noopener noreferrer">Watch on YouTube</a>
        <a class="pna-btn" href="https://github.com/heyaryansingh/persona" target="_blank" rel="noopener noreferrer">View the code</a>
      </div>
    </header>

    <figure id="demo" class="pna-video">
      <div class="pna-embed">
        <iframe
          src="https://www.youtube.com/embed/wafyHTrnPFI?rel=0"
          title="Persona — full demo"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          loading="lazy"
          allowfullscreen></iframe>
      </div>
      <figcaption>Full demo &middot; a live run of "Neuro", a persona studying neurodegeneration. &middot; <a href="https://www.youtube.com/watch?v=wafyHTrnPFI" target="_blank" rel="noopener noreferrer">Open on YouTube</a></figcaption>
    </figure>

    <section>
      <p class="pna-kicker">The problem</p>
      <h2>Our research tools are amnesiac</h2>
      <p>
        Science publishes millions of papers a year, with a reproducibility crisis
        underneath them. A chatbot answers and forgets; a search tool retrieves but holds
        no beliefs, never notices a contradiction, never re-checks itself, and never acts.
        The bottleneck is not generating text — it is a trustworthy memory that reads at
        scale, believes with discipline, and compounds.
      </p>
    </section>

    <section>
      <p class="pna-kicker">What it is</p>
      <h2>A small durable self, a large disposable swarm</h2>
      <p>
        Persona splits a persistent <b>self</b> — interests, a provenance-typed
        belief-state, memory, taste — from an ephemeral <b>swarm</b> of bounded agents
        that read at scale and are then discarded. Every belief is typed (READ, INFERRED,
        HUMAN&#95;CONFIRMED, TESTED), so an inferred claim never wears the authority of a
        proven one.
      </p>
      <div class="pna-stats">
        <div class="pna-stat"><b>~20 min</b><span>blank slate to 13 cited papers</span></div>
        <div class="pna-stat"><b>350</b><span>primary sources read</span></div>
        <div class="pna-stat"><b>200</b><span>beliefs on a temporal graph</span></div>
        <div class="pna-stat"><b>100%</b><span>verified beliefs kept under poisoning</span></div>
      </div>
    </section>

    <section>
      <p class="pna-kicker">Capabilities</p>
      <h2>What a researcher can actually use</h2>
      <div class="pna-grid">
        <div class="pna-card"><h3>Grounded, cited reports</h3><p>Every claim resolves to a real author, journal, and DOI, exportable to PDF. No hallucinated references.</p></div>
        <div class="pna-card"><h3>Robustness auditor</h3><p>statcheck, GRIM, power and p-curve run in code, then a replication likelihood calibrated on real replication outcomes.</p></div>
        <div class="pna-card"><h3>Verified reasoning</h3><p>Derivations machine-checked in sympy or formally proven in Lean 4, and re-tested over time.</p></div>
        <div class="pna-card"><h3>Agent teams that act</h3><p>Teams gather, synthesize, reason, prove, and write in parallel — then escalate to a human when judgment is needed.</p></div>
        <div class="pna-card"><h3>Living knowledge graph</h3><p>Every claim is a node with its year and DOI; contradictions surface as the field moves.</p></div>
        <div class="pna-card"><h3>A transparent workbench</h3><p>Its whole mind is on disk. Watch agents work live and run their Python in a sandbox yourself.</p></div>
      </div>
    </section>

    <section>
      <p class="pna-kicker">What makes it different</p>
      <h2>Others retrieve and score. Persona remembers and acts.</h2>
      <div class="pna-diff">
        <div class="pna-col them">
          <h3>A chatbot or search tool</h3>
          <ul>
            <li>Answers, then forgets the session</li>
            <li>Citations may be fabricated</li>
            <li>No beliefs, no self-correction</li>
            <li>Never runs an experiment</li>
          </ul>
        </div>
        <div class="pna-col us">
          <h3>Persona</h3>
          <ul>
            <li>A durable, provenance-typed belief-state</li>
            <li>Every claim traces to a real paper and DOI</li>
            <li>Flags contradictions and re-audits itself</li>
            <li>Runs code, proves math, escalates to a human</li>
          </ul>
        </div>
      </div>
    </section>

    <section>
      <p class="pna-kicker">Under the hood</p>
      <h2>Built with Claude Code. Claude reasons, code verifies.</h2>
      <p>
        A single mind runs on a heterogeneous fleet of Claude models, routed by task.
        Claude reads and reasons; the arithmetic is run in code and checked — the
        difference between a plausible number and a trustworthy one.
      </p>
      <div class="pna-chips">
        <span class="pna-chip"><b>Opus</b> reflects &amp; judges</span>
        <span class="pna-chip"><b>Sonnet</b> reads, reasons &amp; writes</span>
        <span class="pna-chip"><b>Haiku</b> scouts</span>
      </div>
      <div class="pna-grid two">
        <div class="pna-card"><h3>We tested our own design</h3><p>Under sustained literature poisoning, human-anchored memory kept <b class="o">100%</b> of verified beliefs; naive updating kept only <b class="o">71%</b>.</p></div>
        <div class="pna-card"><h3>Calibrated, not vibes</h3><p>Replication likelihoods are fitted on real labeled outcomes, so 70% means 70%.</p></div>
      </div>
    </section>

    <section>
      <p class="pna-kicker">Run and experiment yourself</p>
      <h2>Seed a mind, then leave it running</h2>
      <p>Open source, runs locally with your own Anthropic key. Give a persona a few interests and watch what it becomes.</p>
      <ol class="pna-steps">
        <li>
          <h3>Get the code</h3>
          <pre>git clone https://github.com/heyaryansingh/persona
cd persona
pip install -r requirements.txt</pre>
        </li>
        <li>
          <h3>Add your API key</h3>
          <p class="dim">Create a <code>.env</code> in the repo root — only <code>ANTHROPIC_API_KEY</code> is required, and it stays on your machine.</p>
          <pre>ANTHROPIC_API_KEY=sk-ant-...</pre>
        </li>
        <li>
          <h3>Run it</h3>
          <pre>python -m persona --port 8137</pre>
          <p class="dim">Open <code>http://127.0.0.1:8137</code>, create a persona, and seed it with a few interests.</p>
        </li>
      </ol>
    </section>

    <footer class="pna-foot">
      <p class="big">Reads at scale. Believes with discipline. Verifies. Compounds.</p>
      <p><a href="https://github.com/heyaryansingh/persona" target="_blank" rel="noopener noreferrer">github.com/heyaryansingh/persona</a></p>
      <p class="made">Made by Aryan Singh &middot; Johns Hopkins University</p>
    </footer>

  </article>
</BaseLayout>

<style>
  .pna{--o:#ff7a18;max-width:960px;margin:0 auto;padding:0 22px 80px;font-family:var(--font-serif,Georgia,serif);color:var(--color-text-primary)}
  .pna .o{color:var(--o)}
  .pna p.pna-kicker,.pna .pna-kicker{font-family:var(--font-mono,ui-monospace,monospace);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--o);margin:0 0 6px;max-width:none}
  .pna h1,.pna h2,.pna h3{font-family:var(--font-mono,ui-monospace,monospace);letter-spacing:-.01em;line-height:1.2}
  .pna a:not(.pna-btn){color:var(--o)}

  .pna-hero{text-align:center;padding:56px 0 26px}
  .pna-hero h1{font-size:clamp(34px,6vw,64px);margin:0 0 14px}
  .pna-lede{font-size:clamp(16px,2.3vw,20px);color:var(--color-text-secondary);max-width:720px;margin:0 auto 24px}
  .pna-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .pna-btn{font-family:var(--font-mono,monospace);font-size:14px;padding:11px 20px;border-radius:9px;border:1px solid var(--color-border);color:var(--color-text-primary);background:var(--color-bg-secondary);transition:.15s;text-decoration:none}
  .pna-btn:hover{border-color:var(--o);color:var(--o)}
  .pna-btn.primary{background:var(--o);color:#160c02;border-color:var(--o);font-weight:600}
  .pna-btn.primary:hover{filter:brightness(1.08);color:#160c02}

  .pna-video{margin:24px 0 8px}
  .pna-embed{position:relative;width:100%;padding-bottom:56.25%;border-radius:14px;overflow:hidden;background:#000;border:1px solid var(--color-border);box-shadow:0 28px 70px -34px rgba(255,122,24,.28)}
  .pna-embed iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .pna-video figcaption{font-family:var(--font-mono,monospace);font-size:12.5px;color:var(--color-text-tertiary);text-align:center;margin-top:10px}

  .pna section{padding:52px 0;border-top:1px solid var(--color-border-subtle)}
  .pna section h2{font-size:clamp(21px,3.2vw,28px);margin:0 0 14px}
  .pna p{max-width:760px;color:var(--color-text-secondary);line-height:1.7}
  .pna p b{color:var(--color-text-primary)}

  .pna-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:22px}
  .pna-stat{background:var(--color-bg-secondary);border:1px solid var(--color-border);border-radius:12px;padding:18px}
  .pna-stat b{display:block;font-family:var(--font-mono,monospace);font-size:28px;color:var(--o);line-height:1}
  .pna-stat span{font-family:var(--font-mono,monospace);font-size:12px;color:var(--color-text-secondary);display:block;margin-top:8px}

  .pna-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:8px}
  .pna-grid.two{grid-template-columns:repeat(2,1fr);margin-top:22px}
  .pna-card{background:var(--color-bg-secondary);border:1px solid var(--color-border);border-radius:12px;padding:20px 22px}
  .pna-card h3{font-size:16px;margin:0 0 8px;color:var(--color-text-primary)}
  .pna-card p{font-size:15px;color:var(--color-text-secondary);margin:0}

  .pna-diff{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:8px}
  .pna-col{border:1px solid var(--color-border);border-radius:12px;padding:20px;background:var(--color-bg-secondary)}
  .pna-col.us{border-color:#4a3416;background:linear-gradient(180deg,rgba(255,122,24,.06),var(--color-bg-secondary))}
  .pna-col ul{margin:8px 0 0;padding-left:18px}
  .pna-col li{font-size:15px;color:var(--color-text-secondary);margin:7px 0}

  .pna-chips{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0 0}
  .pna-chip{font-family:var(--font-mono,monospace);font-size:13px;border:1px solid var(--color-border);border-radius:9px;padding:8px 12px;color:var(--color-text-secondary)}
  .pna-chip b{color:var(--o);font-weight:600}

  .pna pre{background:var(--color-bg-tertiary);border:1px solid var(--color-border);border-radius:10px;padding:15px 18px;overflow-x:auto;font-family:var(--font-mono,monospace);font-size:13.5px;line-height:1.6;color:var(--color-text-primary)}
  .pna code{font-family:var(--font-mono,monospace);color:var(--o)}
  .pna p.dim{color:var(--color-text-tertiary);font-size:15px;margin:0 0 10px}
  ol.pna-steps{counter-reset:s;list-style:none;padding:0;margin:0}
  ol.pna-steps>li{position:relative;padding:0 0 22px 46px}
  ol.pna-steps>li:before{counter-increment:s;content:counter(s);position:absolute;left:0;top:-2px;width:30px;height:30px;border-radius:50%;border:1px solid var(--o);color:var(--o);font-family:var(--font-mono,monospace);font-size:14px;display:flex;align-items:center;justify-content:center}
  ol.pna-steps h3{font-size:16px;margin:2px 0 8px}

  .pna-foot{border-top:1px solid var(--color-border-subtle);padding:34px 0 0;text-align:center;font-family:var(--font-mono,monospace);color:var(--color-text-tertiary);font-size:13px}
  .pna-foot .big{font-family:var(--font-mono,monospace);color:var(--color-text-primary);font-size:15px;max-width:none}
  .pna-foot .made{margin-top:12px;color:var(--color-text-secondary)}

  @media(max-width:720px){
    .pna-stats{grid-template-columns:repeat(2,1fr)}
    .pna-grid,.pna-grid.two,.pna-diff{grid-template-columns:1fr}
  }
</style>
