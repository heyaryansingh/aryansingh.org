---
/**
 * Book detail — /reading/[slug]
 *
 * Renders one book from the `reads` collection: an image-free CSS "jacket",
 * a metadata rail, the factual overview, and my own long-form notes (the MDX
 * body). This is where thoughts are written and published — just edit the
 * book's .mdx file body.
 */

import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const books = await getCollection("reads");
    return books.map((book) => ({
        params: { slug: book.slug },
        props: { book },
    }));
}

type Props = { book: CollectionEntry<"reads"> };

const { book } = Astro.props;
const { Content } = await book.render();

// Does the MDX body contain real notes (ignoring comments/whitespace)?
const hasNotes =
    book.body.replace(/\{\/\*[\s\S]*?\*\/\}/g, "").trim().length > 0;

function fmt(date?: Date) {
    if (!date) return "";
    return new Intl.DateTimeFormat("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
    }).format(date);
}

function daysBetween(a?: Date, b?: Date) {
    if (!a || !b) return null;
    const ms = b.valueOf() - a.valueOf();
    return Math.max(1, Math.round(ms / 86400000));
}

const span =
    book.data.status === "completed"
        ? daysBetween(book.data.startedDate, book.data.finishedDate)
        : null;

const meta: { label: string; value: string }[] = [
    { label: "Author", value: book.data.author },
    { label: "Format", value: book.data.type },
    {
        label: "Status",
        value: book.data.status === "reading" ? "Currently reading" : "Finished",
    },
];

if (book.data.startedDate)
    meta.push({ label: "Started", value: fmt(book.data.startedDate) });
if (book.data.finishedDate)
    meta.push({ label: "Finished", value: fmt(book.data.finishedDate) });
if (span)
    meta.push({ label: "Read in", value: `${span} day${span === 1 ? "" : "s"}` });
if (book.data.rating != null)
    meta.push({ label: "Rating", value: `${book.data.rating} / 5` });

function monogram(title: string) {
    const words = title.replace(/^(the|a|an)\s+/i, "").split(/\s+/);
    return (words[0]?.[0] ?? "") + (words[1]?.[0] ?? "");
}
---

<BaseLayout
    title={`${book.data.title} — Reading`}
    description={book.data.overview}
>
    <article class="read" style={`--spine: ${book.data.spine}`}>
        <a href="/reading" class="read__back">← The Stacks</a>

        <div class="read__hero">
            <div class="read__jacket" aria-hidden="true">
                <span class="read__mono">{monogram(book.data.title)}</span>
                {
                    book.data.status === "reading" && (
                        <span class="read__badge">Reading</span>
                    )
                }
            </div>

            <div class="read__intro">
                <h1 class="read__title">{book.data.title}</h1>
                <p class="read__author">{book.data.author}</p>

                {
                    book.data.tags.length > 0 && (
                        <ul class="read__tags">
                            {book.data.tags.map((t) => (
                                <li class="read__tag">{t}</li>
                            ))}
                        </ul>
                    )
                }

                <a
                    href={book.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="read__find"
                >
                    Find it online ↗
                </a>
            </div>
        </div>

        <div class="read__grid">
            <aside class="read__meta">
                <dl>
                    {
                        meta.map((m) => (
                            <div class="read__metarow">
                                <dt>{m.label}</dt>
                                <dd>{m.value}</dd>
                            </div>
                        ))
                    }
                </dl>
            </aside>

            <div class="read__main">
                <section class="read__section">
                    <h2 class="read__h2">Overview</h2>
                    <p class="read__lede">{book.data.overview}</p>
                </section>

                <section class="read__section">
                    <h2 class="read__h2">My notes</h2>
                    {
                        hasNotes ? (
                            <div class="prose">
                                <Content />
                            </div>
                        ) : (
                            <p class="read__empty">
                                I haven't written up my thoughts on this one yet —
                                check back, or
                                <a
                                    href={book.data.link}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    read it yourself
                                </a>
                                in the meantime.
                            </p>
                        )
                    }
                </section>
            </div>
        </div>
    </article>
</BaseLayout>

<style>
    .read {
        max-width: 860px;
        margin: 0 auto;
        padding: var(--space-xl) var(--space-xl) var(--space-4xl);
    }

    .read__back {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        color: var(--color-text-tertiary);
        margin-bottom: var(--space-2xl);
        background: none;
    }

    .read__back:hover {
        color: var(--color-accent-primary);
        background: none;
    }

    /* ---------- Hero ---------- */
    .read__hero {
        display: grid;
        grid-template-columns: 132px 1fr;
        gap: var(--space-xl);
        align-items: center;
        margin-bottom: var(--space-2xl);
    }

    .read__jacket {
        position: relative;
        aspect-ratio: 2 / 3;
        border-radius: 3px 7px 7px 3px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 12px;
        background: linear-gradient(
            120deg,
            color-mix(in srgb, var(--spine) 92%, white 8%),
            color-mix(in srgb, var(--spine) 65%, black 35%)
        );
        box-shadow:
            inset 10px 0 14px -10px rgba(0, 0, 0, 0.7),
            inset -1px 0 0 rgba(255, 255, 255, 0.14),
            0 14px 34px rgba(0, 0, 0, 0.45);
    }

    .read__jacket::after {
        content: "";
        position: absolute;
        top: 6%;
        bottom: 6%;
        left: 11px;
        width: 1px;
        background: rgba(255, 255, 255, 0.2);
    }

    .read__mono {
        font-family: var(--font-serif);
        font-size: 1.9rem;
        font-weight: 600;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.92);
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
    }

    .read__badge {
        position: absolute;
        top: 10px;
        right: -7px;
        font-family: var(--font-mono);
        font-size: 0.6rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #fff;
        background: rgba(0, 0, 0, 0.45);
        padding: 3px 8px;
        border-radius: var(--radius-sm);
        backdrop-filter: blur(2px);
    }

    .read__title {
        font-family: var(--font-serif);
        font-size: var(--text-4xl);
        font-weight: 400;
        line-height: 1.08;
        margin: 0;
    }

    .read__author {
        margin: var(--space-sm) 0 var(--space-md);
        font-size: var(--text-lg);
        font-style: italic;
        color: var(--color-text-secondary);
    }

    .read__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        list-style: none;
        padding: 0;
        margin: 0 0 var(--space-md);
    }

    .read__tag {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        padding: 2px 9px;
        border-radius: var(--radius-full);
        border: 1px solid var(--color-border);
        color: var(--color-text-tertiary);
        text-transform: lowercase;
    }

    .read__find {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-accent-primary);
        background: none;
    }

    .read__find:hover {
        color: var(--color-accent-highlight);
        background: none;
    }

    /* ---------- Body grid ---------- */
    .read__grid {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: var(--space-2xl);
        padding-top: var(--space-xl);
        border-top: 1px solid var(--color-border-subtle);
    }

    .read__meta dl {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        position: sticky;
        top: 90px;
    }

    .read__metarow {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding-left: var(--space-md);
        border-left: 2px solid color-mix(in srgb, var(--spine) 55%, var(--color-border));
    }

    .read__metarow dt {
        font-family: var(--font-mono);
        font-size: 0.66rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-text-tertiary);
    }

    .read__metarow dd {
        margin: 0;
        font-size: var(--text-sm);
        color: var(--color-text-primary);
    }

    .read__section {
        margin-bottom: var(--space-2xl);
    }

    .read__h2 {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-text-tertiary);
        margin: 0 0 var(--space-md);
    }

    .read__lede {
        font-family: var(--font-serif);
        font-size: var(--text-lg);
        line-height: 1.6;
        color: var(--color-text-secondary);
        margin: 0;
    }

    .read__empty {
        font-size: var(--text-sm);
        line-height: 1.7;
        color: var(--color-text-tertiary);
        padding: var(--space-lg);
        border: 1px dashed var(--color-border);
        border-radius: var(--radius-lg);
        margin: 0;
    }

    .read__empty a {
        color: var(--color-accent-primary);
        margin-left: 4px;
    }

    /* ---------- Prose (rendered MDX notes) ---------- */
    .prose {
        max-width: 65ch;
        color: var(--color-text-secondary);
        line-height: 1.8;
    }

    .prose :global(p) {
        margin-bottom: var(--space-lg);
    }

    .prose :global(h2),
    .prose :global(h3) {
        font-family: var(--font-serif);
        color: var(--color-text-primary);
        margin: var(--space-xl) 0 var(--space-sm);
    }

    .prose :global(a) {
        color: var(--color-accent-primary);
    }

    .prose :global(blockquote) {
        border-left: 2px solid var(--spine);
        padding-left: var(--space-lg);
        font-style: italic;
        color: var(--color-text-primary);
        margin: var(--space-xl) 0;
    }

    .prose :global(img) {
        max-width: 100%;
        border-radius: var(--radius-md);
        margin: var(--space-xl) 0;
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 720px) {
        .read__hero {
            grid-template-columns: 96px 1fr;
            gap: var(--space-lg);
        }

        .read__grid {
            grid-template-columns: 1fr;
            gap: var(--space-xl);
        }

        .read__meta dl {
            position: static;
            flex-direction: row;
            flex-wrap: wrap;
            gap: var(--space-md) var(--space-lg);
        }
    }
</style>
