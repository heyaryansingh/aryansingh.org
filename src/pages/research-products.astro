---
import BaseLayout from "../layouts/BaseLayout.astro";
import products from "../data/researchflow-products.json";

const topProducts = [...products].sort((a, b) => Number(b.score || 0) - Number(a.score || 0));
const featured = topProducts[0];
const productCount = topProducts.length;
const avgScore =
  topProducts.reduce((total, item) => total + Number(item.score || 0), 0) /
  Math.max(productCount, 1);
---

<BaseLayout
  title="Research Products"
  description="ResearchFlow-built products, tools, and experiments from recent papers and real market signals."
  image="/researchflow/researchflow-hero.png"
>
  <section class="rf-hero" data-rf-stage>
    <div class="rf-hero__media" aria-hidden="true">
      <img src="/researchflow/researchflow-hero.png" alt="" loading="eager" />
      <svg class="rf-hero__paths" viewBox="0 0 1200 700" preserveAspectRatio="none">
        <path class="rf-path rf-path--one" d="M40 530 C 260 250, 390 710, 620 350 S 920 80, 1160 220" />
        <path class="rf-path rf-path--two" d="M20 200 C 220 80, 480 230, 610 120 S 920 120, 1190 470" />
        <path class="rf-path rf-path--three" d="M90 650 C 310 520, 470 420, 650 540 S 1010 650, 1170 360" />
      </svg>
    </div>

    <div class="rf-hero__copy">
      <p class="rf-kicker">ResearchFlow launch lab</p>
      <h1>Daily research agents, pointed at products that can matter.</h1>
      <p class="rf-lede">
        ResearchFlow watches papers, tools, developer pain, company shifts, and market signals,
        then turns the strongest ideas into useful GitHub projects with clear positioning,
        launch pages, validation checks, and monetization hypotheses.
      </p>
      <div class="rf-actions">
        <a class="rf-button rf-button--primary" href="#products">See products</a>
        <a class="rf-button" href="https://github.com/heyaryansingh/research-flow" target="_blank" rel="noopener noreferrer">View engine</a>
      </div>
    </div>

    <div class="rf-console" aria-label="ResearchFlow metrics">
      <div>
        <span>{productCount}</span>
        <small>tracked builds</small>
      </div>
      <div>
        <span>{avgScore.toFixed(1)}</span>
        <small>avg product score</small>
      </div>
      <div>
        <span>daily</span>
        <small>agent cadence</small>
      </div>
    </div>
  </section>

  <section class="rf-pipeline" data-rf-stage>
    <div class="rf-section-head">
      <p class="rf-kicker">How the machine thinks</p>
      <h2>Paper to pain to product to launch.</h2>
      <p>
        The goal is not to produce another pile of demos. Each build needs a user,
        a problem, a why-now reason, a useful first workflow, and a credible next step.
      </p>
    </div>

    <div class="rf-pipeline__grid">
      {[
        ["Scout", "Find recent papers, tools, posts, company shifts, and emerging complaints."],
        ["Synthesize", "Cluster market pain and match it to research that unlocks a better workflow."],
        ["Build", "Ship the smallest polished tool with tests, docs, GitHub metadata, and a launch plan."],
        ["Review", "Check usefulness, reliability, discoverability, and whether it deserves more investment."],
        ["Launch", "Publish to GitHub and this site, then add paid paths only when demand is real."],
      ].map(([title, text], index) => (
        <article class="rf-stage-card" style={`--stage-delay: ${index * 90}ms`}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="rf-products" id="products" data-rf-stage>
    <div class="rf-section-head">
      <p class="rf-kicker">Generated portfolio</p>
      <h2>Builds with positioning, evidence, and launch paths.</h2>
    </div>

    <div class="rf-products__layout">
      {featured && (
        <article class="rf-featured">
          <img src={featured.coverImage || "/researchflow/researchflow-hero.png"} alt="" loading="lazy" />
          <div class="rf-featured__body">
            <p class="rf-kicker">Featured build</p>
            <h3>{featured.title}</h3>
            <p>{featured.valueProposition || featured.description}</p>
            <dl>
              <div>
                <dt>Problem</dt>
                <dd>{featured.problem}</dd>
              </div>
              <div>
                <dt>Why now</dt>
                <dd>{featured.whyNow}</dd>
              </div>
            </dl>
            <div class="rf-actions">
              {featured.github && (
                <a class="rf-button rf-button--primary" href={featured.github} target="_blank" rel="noopener noreferrer">GitHub</a>
              )}
              {featured.demo && (
                <a class="rf-button" href={featured.demo} target="_blank" rel="noopener noreferrer">Launch page</a>
              )}
            </div>
          </div>
        </article>
      )}

      <div class="rf-product-list">
        {topProducts.map((product, index) => (
          <article class="rf-product-card" style={`--stage-delay: ${index * 80}ms`}>
            <div class="rf-product-card__top">
              <span>{product.score ? Number(product.score).toFixed(1) : "new"}</span>
              <small>score</small>
            </div>
            <h3>{product.title}</h3>
            <p>{product.description}</p>
            <div class="rf-tags">
              {(product.topics || []).slice(0, 5).map((topic) => <span>{topic}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .rf-hero,
  .rf-pipeline,
  .rf-products {
    position: relative;
    overflow: hidden;
  }

  .rf-hero {
    min-height: calc(100svh - 64px);
    display: grid;
    align-items: center;
    padding: clamp(3rem, 8vw, 7rem) var(--space-lg);
  }

  .rf-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .rf-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, var(--color-bg-primary) 0%, rgba(10, 10, 12, 0.82) 38%, rgba(10, 10, 12, 0.22) 100%),
      radial-gradient(circle at 18% 45%, rgba(74, 95, 189, 0.22), transparent 28%),
      linear-gradient(180deg, rgba(10, 10, 12, 0.12), var(--color-bg-primary) 96%);
  }

  .rf-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.1) contrast(1.08);
  }

  .rf-hero__paths {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.72;
    pointer-events: none;
  }

  .rf-path {
    fill: none;
    stroke: rgba(123, 143, 232, 0.56);
    stroke-width: 1.4;
    stroke-dasharray: 18 26;
    animation: rf-drift 12s linear infinite;
  }

  .rf-path--two {
    stroke: rgba(62, 218, 255, 0.38);
    animation-duration: 16s;
  }

  .rf-path--three {
    stroke: rgba(232, 232, 236, 0.22);
    animation-duration: 20s;
  }

  @keyframes rf-drift {
    to { stroke-dashoffset: -220; }
  }

  .rf-hero__copy {
    position: relative;
    z-index: 2;
    max-width: 760px;
  }

  .rf-kicker {
    margin: 0 0 var(--space-md);
    color: var(--color-accent-highlight);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .rf-hero h1 {
    max-width: 920px;
    margin: 0 0 var(--space-lg);
    font-size: clamp(3.2rem, 8vw, 7.4rem);
    letter-spacing: 0;
  }

  .rf-lede {
    max-width: 700px;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .rf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .rf-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--space-lg);
    border: 1px solid rgba(232, 232, 236, 0.18);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    background: rgba(10, 10, 12, 0.58);
    backdrop-filter: blur(12px);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .rf-button--primary {
    border-color: rgba(123, 143, 232, 0.66);
    background: linear-gradient(135deg, rgba(74, 95, 189, 0.82), rgba(19, 148, 180, 0.54));
  }

  .rf-console {
    position: absolute;
    right: var(--space-xl);
    bottom: var(--space-xl);
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(92px, 1fr));
    gap: 1px;
    max-width: 440px;
    border: 1px solid rgba(232, 232, 236, 0.12);
    background: rgba(232, 232, 236, 0.08);
    backdrop-filter: blur(18px);
  }

  .rf-console div {
    padding: var(--space-md);
    background: rgba(10, 10, 12, 0.72);
  }

  .rf-console span {
    display: block;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
  }

  .rf-console small {
    color: var(--color-text-tertiary);
  }

  .rf-pipeline,
  .rf-products {
    padding: clamp(4rem, 9vw, 8rem) var(--space-lg);
  }

  .rf-section-head {
    max-width: 760px;
    margin: 0 auto var(--space-2xl);
    text-align: center;
  }

  .rf-section-head h2 {
    margin-bottom: var(--space-md);
    font-size: clamp(2.5rem, 6vw, 5.2rem);
    letter-spacing: 0;
  }

  .rf-pipeline__grid {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .rf-stage-card,
  .rf-product-card,
  .rf-featured {
    border: 1px solid rgba(232, 232, 236, 0.12);
    background:
      linear-gradient(145deg, rgba(232, 232, 236, 0.08), rgba(232, 232, 236, 0.02)),
      rgba(10, 10, 12, 0.58);
    backdrop-filter: blur(14px);
  }

  .rf-stage-card {
    min-height: 260px;
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    transform: translateY(22px);
    opacity: 0;
    transition: transform 700ms var(--ease-out-expo), opacity 700ms var(--ease-out-expo);
    transition-delay: var(--stage-delay);
  }

  .rf-stage-card span,
  .rf-product-card__top span {
    color: var(--color-accent-highlight);
    font-family: var(--font-mono);
  }

  .rf-stage-card h3 {
    margin-top: var(--space-xl);
    font-size: var(--text-2xl);
    letter-spacing: 0;
  }

  .rf-stage-card p,
  .rf-product-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .rf-products__layout {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: var(--space-lg);
    align-items: start;
  }

  .rf-featured {
    position: sticky;
    top: 96px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .rf-featured img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .rf-featured__body {
    padding: var(--space-xl);
  }

  .rf-featured h3 {
    margin-bottom: var(--space-md);
    font-size: var(--text-4xl);
    letter-spacing: 0;
  }

  .rf-featured dl {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .rf-featured dt {
    color: var(--color-accent-highlight);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .rf-featured dd {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .rf-product-list {
    display: grid;
    gap: var(--space-md);
  }

  .rf-product-card {
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    transform: translateY(22px);
    opacity: 0;
    transition: border-color 250ms ease, transform 700ms var(--ease-out-expo), opacity 700ms var(--ease-out-expo);
    transition-delay: var(--stage-delay);
  }

  .rf-product-card:hover {
    border-color: rgba(123, 143, 232, 0.72);
  }

  .rf-product-card__top {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .rf-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
  }

  .rf-tags span {
    border: 1px solid rgba(232, 232, 236, 0.12);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.45rem;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  [data-rf-stage].is-visible .rf-stage-card,
  [data-rf-stage].is-visible .rf-product-card {
    transform: translateY(0);
    opacity: 1;
  }

  @media (max-width: 980px) {
    .rf-pipeline__grid,
    .rf-products__layout {
      grid-template-columns: 1fr;
    }

    .rf-featured {
      position: relative;
      top: auto;
    }
  }

  @media (max-width: 680px) {
    .rf-hero {
      min-height: auto;
      padding-top: var(--space-3xl);
    }

    .rf-console {
      position: relative;
      right: auto;
      bottom: auto;
      margin-top: var(--space-xl);
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rf-path {
      animation: none;
    }
  }
</style>

<script>
  const stages = document.querySelectorAll("[data-rf-stage]");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
        }
      });
    },
    { threshold: 0.2 },
  );

  stages.forEach((stage) => observer.observe(stage));
</script>
