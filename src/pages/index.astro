---
/**
 * Homepage — bold hero, credential band, featured work, and a random quote.
 * Photos are auto-discovered from src/assets/me/.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import RandomPhoto from "../components/RandomPhoto";
import RandomQuote from "../components/RandomQuote";
import { getSortedProjects, CATEGORY_META } from "../lib/projects";

// Auto-discover all photos from src/assets/me/
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/me/*.{jpg,jpeg,png,webp,gif,JPG,JPEG,PNG,WEBP,GIF}",
  { eager: true }
);
const photos = Object.values(photoFiles).map((file) => ({ src: file.default.src }));

const projects = await getSortedProjects();
const featured = projects.filter((p) => p.data.pinned || p.data.featured).slice(0, 3);

const highlights = [
  { big: "Founding AI Dev", small: "NeuroVoice · Rice University" },
  { big: "USACO Platinum", small: "top 0.5% nationally" },
  { big: "$150K+ raised", small: "seed funding, 8-state pilots" },
  { big: "4.0 GPA", small: "CS + BME @ Johns Hopkins" },
];
---

<BaseLayout
  title="aryan singh"
  description="Aryan Singh — CS + BME at Johns Hopkins. Building at the edge of AI, quantum, and biotech."
>
  <div class="home">
    <section class="hero">
      <div class="hero__photo animate-fade-in">
        <RandomPhoto client:load photos={photos} defaultCaption="random photo of me" />
      </div>

      <div class="hero__content">
        <p class="hero__eyebrow animate-slide-up">Baltimore, MD · open to internships & research</p>
        <h1 class="hero__name animate-slide-up delay-1">aryan singh</h1>
        <p class="hero__role animate-slide-up delay-2">
          I build at the edge of <span class="accent">AI</span>, <span class="accent">quantum</span>,
          and <span class="accent">biotech</span>.
        </p>
        <p class="hero__about animate-fade-in delay-3">
          Student at Johns Hopkins studying CS and BME. I like turning hard research ideas into things
          you can actually run — simulators, agents, ML systems — and writing about the process.
        </p>

        <div class="hero__cta animate-fade-in delay-4">
          <a class="btn btn--primary" href="/portfolio">View my work →</a>
          <a class="btn" href="/playground">Playground 🎮</a>
          <a class="btn" href="/resume">Résumé</a>
        </div>

        <div class="hero__links animate-fade-in delay-5">
          <a href="mailto:aryanrheasingh@gmail.com">email</a>
          <a href="https://github.com/heyaryansingh" target="_blank" rel="noopener">github</a>
          <a href="https://linkedin.com/in/real-aryan-singh" target="_blank" rel="noopener">linkedin</a>
        </div>
      </div>
    </section>

    <section class="strip">
      {highlights.map((h) => (
        <div class="strip__item">
          <span class="strip__big">{h.big}</span>
          <span class="strip__small">{h.small}</span>
        </div>
      ))}
    </section>

    {featured.length > 0 && (
      <section class="featured">
        <div class="featured__head">
          <h2 class="featured__title">Featured work</h2>
          <a class="featured__all" href="/portfolio">all projects →</a>
        </div>
        <div class="featured__grid">
          {featured.map((p) => {
            const cat = CATEGORY_META[p.data.category];
            return (
              <a class="fcard" href={`/portfolio/${p.slug}`} style={`--cat:${cat.color}`}>
                <span class="fcard__cat">{cat.icon} {cat.label}</span>
                <h3 class="fcard__title">{p.data.title}</h3>
                <p class="fcard__tag">{p.data.tagline}</p>
                <span class="fcard__go">Read case study →</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="quote">
      <p class="quote__label">a random quote:</p>
      <RandomQuote client:load />
    </section>

    <div class="home__hint">
      <kbd id="nav-shortcut">Ctrl+K</kbd> to navigate
    </div>
  </div>

  <script is:inline>
    (function () {
      var isMac = /Mac|iPhone|iPad|iPod/i.test(navigator.platform || navigator.userAgent);
      var el = document.getElementById("nav-shortcut");
      if (el && isMac) el.textContent = "⌘K";
    })();
  </script>
</BaseLayout>

<style>
  .home { max-width: 1000px; margin: 0 auto; padding: clamp(var(--space-lg), 5vw, var(--space-2xl)); }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3xl);
    align-items: center;
    padding: clamp(var(--space-lg), 6vw, var(--space-3xl)) 0 var(--space-2xl);
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; text-align: center; gap: var(--space-xl); }
    .hero__photo { justify-self: center; }
    .hero__cta, .hero__links { justify-content: center; }
  }
  .hero__photo { min-width: 150px; max-width: 260px; }
  .hero__content { max-width: 520px; }

  .hero__eyebrow { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase;
    letter-spacing: 0.15em; color: var(--color-accent-secondary); margin: 0; }
  .hero__name {
    font-family: var(--font-serif); font-size: var(--text-6xl); font-weight: 400; line-height: 1;
    letter-spacing: -0.03em; margin: var(--space-sm) 0 0;
    background: linear-gradient(120deg, var(--color-text-primary) 30%, var(--color-accent-highlight));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .hero__role { font-size: var(--text-xl); color: var(--color-text-secondary); margin: var(--space-md) 0 0; line-height: 1.4; }
  .hero__role .accent { color: var(--color-accent-highlight); font-style: italic; }
  .hero__about { font-size: var(--text-base); color: var(--color-text-secondary); line-height: 1.7; margin: var(--space-lg) 0 0; }

  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-xl); }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: var(--radius-md);
    border: 1px solid var(--color-border); background: var(--color-bg-secondary); color: var(--color-text-primary);
    font-size: var(--text-sm); transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast); }
  .btn:hover { transform: translateY(-2px); border-color: var(--color-accent-primary); }
  .btn--primary { background: var(--color-accent-primary); border-color: var(--color-accent-primary); color: #fff; }
  .btn--primary:hover { background: var(--color-accent-secondary); }

  .hero__links { display: flex; gap: var(--space-md); margin-top: var(--space-lg); }
  .hero__links a { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-tertiary); }
  .hero__links a:hover { color: var(--color-accent-primary); }

  /* CREDENTIAL STRIP */
  .strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md);
    padding: var(--space-lg); margin-top: var(--space-lg);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary); }
  .strip__item { display: flex; flex-direction: column; gap: 2px; text-align: center; }
  .strip__big { font-family: var(--font-serif); font-size: var(--text-lg); color: var(--color-text-primary); }
  .strip__small { font-size: var(--text-xs); color: var(--color-text-tertiary); }
  @media (max-width: 760px) { .strip { grid-template-columns: 1fr 1fr; } }

  /* FEATURED */
  .featured { margin-top: var(--space-3xl); }
  .featured__head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--space-lg); }
  .featured__title { font-size: var(--text-2xl); margin: 0; }
  .featured__all { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-accent-secondary); }
  .featured__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-md); }
  .fcard { display: flex; flex-direction: column; gap: var(--space-xs); padding: var(--space-lg);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary);
    transition: transform var(--transition-base) var(--ease-out-expo), border-color var(--transition-base); }
  .fcard:hover { transform: translateY(-4px); border-color: var(--cat); }
  .fcard__cat { font-size: var(--text-xs); color: var(--cat); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
  .fcard__title { font-family: var(--font-serif); font-size: var(--text-xl); margin: 2px 0 0; color: var(--color-text-primary); }
  .fcard__tag { font-size: var(--text-sm); color: var(--color-text-secondary); margin: 0; font-style: italic; }
  .fcard__go { margin-top: auto; padding-top: var(--space-sm); font-size: var(--text-xs); color: var(--color-text-tertiary);
    transition: color var(--transition-fast); }
  .fcard:hover .fcard__go { color: var(--cat); }

  /* QUOTE */
  .quote { max-width: 460px; margin: var(--space-3xl) 0 0; }
  .quote__label { font-size: var(--text-xs); color: var(--color-text-tertiary); margin: 0 0 var(--space-sm); opacity: 0.7; }

  .home__hint { position: fixed; bottom: var(--space-xl); right: var(--space-xl); font-size: var(--text-xs);
    color: var(--color-text-tertiary); opacity: 0.5; z-index: 5; }
  .home__hint kbd { padding: 2px 6px; background: var(--color-bg-tertiary); border-radius: 4px; font-family: var(--font-mono); }
  @media (max-width: 768px) { .home__hint { display: none; } }

  /* ANIMATIONS */
  @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .animate-slide-up { animation: slideUp 0.6s var(--ease-out-expo) forwards; opacity: 0; }
  .animate-fade-in { animation: fadeIn 0.7s ease forwards; opacity: 0; }
  .delay-1 { animation-delay: 0.08s; }
  .delay-2 { animation-delay: 0.16s; }
  .delay-3 { animation-delay: 0.26s; }
  .delay-4 { animation-delay: 0.36s; }
  .delay-5 { animation-delay: 0.46s; }
</style>
