---
/**
 * ProjectCard — a single project in the portfolio grid.
 * Driven by the `projects` content collection.
 */
import type { ProjectEntry } from "../lib/projects";
import { CATEGORY_META, STATUS_META } from "../lib/projects";

interface Props {
  project: ProjectEntry;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const d = project.data;
const cat = CATEGORY_META[d.category];
const status = STATUS_META[d.status];
const href = `/portfolio/${project.slug}`;
---

<article
  class:list={["pcard", { "pcard--featured": d.featured }]}
  data-category={d.category}
  data-reveal
  style={`--delay:${index * 45}ms; --cat:${cat.color}`}
>
  <a class="pcard__hit" href={href} aria-label={`Read the ${d.title} case study`}></a>

  <div class="pcard__top">
    <span class="pcard__cat">{cat.label}</span>
    <span class="pcard__meta">
      {status && <span class="pcard__status" style={`--sc:${status.color}`}>{status.label}</span>}
      {d.year && <span class="pcard__year">{d.year}</span>}
    </span>
  </div>

  <h3 class="pcard__title">{d.title}</h3>
  <p class="pcard__tagline">{d.tagline}</p>
  <p class="pcard__desc">{d.description}</p>

  {d.metrics.length > 0 && (
    <ul class="pcard__metrics">
      {d.metrics.slice(0, 3).map((m) => <li>{m}</li>)}
    </ul>
  )}

  <div class="pcard__tech">
    {d.techStack.slice(0, 5).map((t) => <span class="pcard__chip">{t}</span>)}
  </div>

  <div class="pcard__foot">
    <span class="pcard__read">Case study →</span>
    <span class="pcard__links">
      {d.github && (
        <a class="pcard__ext" href={d.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="Source">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49.99.1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
      )}
      {d.demo && (
        <a class="pcard__ext pcard__ext--primary" href={d.demo} target="_blank" rel="noopener noreferrer" aria-label="Live demo" title="Demo">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      )}
      {d.closedSource && !d.github && (
        <span class="pcard__lock" title="Closed source">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
      )}
    </span>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    overflow: hidden;
    transition: border-color var(--transition-base);
  }
  .pcard::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--cat);
    opacity: 0;
    transition: opacity var(--transition-base);
  }
  .pcard:hover {
    border-color: color-mix(in srgb, var(--cat) 55%, var(--color-border));
  }
  .pcard:hover::before { opacity: 1; }
  .pcard--featured { border-color: color-mix(in srgb, var(--cat) 35%, var(--color-border)); }

  /* Whole-card click target to the case study; external links sit above it. */
  .pcard__hit { position: absolute; inset: 0; z-index: 1; background: none; }
  .pcard > *:not(.pcard__hit) { position: relative; z-index: 2; pointer-events: none; }
  .pcard__foot a, .pcard__foot .pcard__lock { pointer-events: auto; }

  .pcard__top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
  .pcard__cat { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs);
    font-weight: 600; color: var(--cat); letter-spacing: 0.04em; text-transform: uppercase; }
  .pcard__cat-icon { font-size: 0.95rem; }
  .pcard__meta { display: inline-flex; align-items: center; gap: var(--space-sm); }
  .pcard__status { font-size: var(--text-xs); padding: 2px 8px; border-radius: var(--radius-full);
    color: var(--sc); background: color-mix(in srgb, var(--sc) 16%, transparent); font-weight: 500; }
  .pcard__year { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-tertiary); }

  .pcard__title { font-family: var(--font-serif); font-size: var(--text-2xl); line-height: 1.15;
    margin: 4px 0 0; color: var(--color-text-primary); }
  .pcard__tagline { font-size: var(--text-sm); color: var(--cat); font-style: italic; margin: 0; }
  .pcard__desc { font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.6; margin: 4px 0 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .pcard__metrics { list-style: none; margin: var(--space-sm) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .pcard__metrics li { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-primary);
    background: var(--color-bg-tertiary); border: 1px solid var(--color-border-subtle);
    padding: 3px 8px; border-radius: var(--radius-sm); }

  .pcard__tech { display: flex; flex-wrap: wrap; gap: 5px; margin-top: var(--space-sm); }
  .pcard__chip { font-size: var(--text-xs); color: var(--color-text-tertiary); font-family: var(--font-mono);
    padding: 2px 8px; border-radius: var(--radius-sm); border: 1px solid var(--color-border-subtle); }

  .pcard__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md);
    margin-top: auto; padding-top: var(--space-md); border-top: 1px solid var(--color-border-subtle); }
  .pcard__read { font-size: var(--text-sm); color: var(--color-text-secondary);
    transition: color var(--transition-fast), transform var(--transition-fast); }
  .pcard:hover .pcard__read { color: var(--cat); transform: translateX(3px); }
  .pcard__links { display: inline-flex; align-items: center; gap: var(--space-sm); }
  .pcard__ext { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: var(--radius-sm);
    color: var(--color-text-secondary); border: 1px solid var(--color-border); background: var(--color-bg-primary); }
  .pcard__ext:hover { color: var(--color-text-primary); border-color: var(--cat); }
  .pcard__ext--primary { color: var(--cat); }
  .pcard__lock { display: inline-grid; place-items: center; width: 30px; height: 30px; color: var(--color-text-tertiary); }

  @media (min-width: 1024px) {
    .pcard--featured { grid-column: span 2; }
  }
</style>
